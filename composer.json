{
    "name": "silvershop/invoicing",
    "description": "Immutable financial documents (invoices / credit memos) with overridable templates for SilverShop.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "invoice", "accounting"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-invoicing/graphs/contributors"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RVXD/silvershop-ledger.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silvershop/core": "^6",
        "silvershop/ledger": "*@dev",
        "dompdf/dompdf": "^3.0",
        "lekoala/silverstripe-cms-actions": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "silverstripe/sqlite3": "^4"
    },
    "suggest": {
        "silvershop/store-profile": "Central shop identity (name, address, VAT, logo) shared with shipping labels and other modules."
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Invoicing\\": "src/",
            "SilverShop\\Invoicing\\Tests\\": "tests/unit/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
